# ==============================================================================
# UY BOZOR: Frontend Muhit O'zgaruvchilari Namunalari (.env.example)
# DIQQAT: Faqat VITE_ prefiksli public o'zgaruvchilar brauzerga chiqadi.
# Hech qachon bot tokenlari yoki maxfiy kalitlarni bu yerga kiritmang!
# ==============================================================================

# Supabase Sozlamalari (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Telegram Bot Public Username'lari (Faqat t.me/ havolalari uchun, token EMAS!)
VITE_TELEGRAM_ADMIN_BOT_USERNAME=Uybozorinbot
VITE_TELEGRAM_USER_BOT_USERNAME=uybozorcodebot

# Sayt domeni
SITE_URL=https://www.uybozor.store/
