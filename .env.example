# 1. Admin Boti (Ruxsat so'rash boti: e'lon moderatsiyasi, admin panelga kirish 2FA, tahrirlash ruxsati)
VITE_TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token_here
VITE_ADMIN_CHAT_ID=your_admin_telegram_chat_id_here
VITE_TELEGRAM_ADMIN_BOT_USERNAME=Uybozorinbot

# 2. Foydalanuvchi Boti (Faqat kod olish uchun: ro'yxatdan o'tish va parolni tiklash kodi)
VITE_TELEGRAM_USER_BOT_TOKEN=your_user_bot_token_here
VITE_TELEGRAM_USER_BOT_USERNAME=uybozorcodebot

# Supabase sozlamalari
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Eslatma: Admin autentifikatsiyasi frontendda emas, Supabase server-side RPC / Edge Function da amalga oshiriladi.
